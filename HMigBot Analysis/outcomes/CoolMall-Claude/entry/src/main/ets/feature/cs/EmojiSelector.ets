@ComponentV2
export struct EmojiSelector {
  @Event onEmojiSelected: (emoji: string) => void = (emoji: string) => {
  };

  build() {
    Column() {
      // top border line (colorScheme.outline)
      Divider()
        .width('100%')
        .strokeWidth(1)
        .color($r('app.color.divider'))

      Grid() {
        ForEach(CHAT_EMOJIS, (emoji: string) => {
          GridItem() {
            Stack({ alignContent: Alignment.Center }) { // source Box(contentAlignment = Center)
              Text(emoji)
                .fontSize(Dimens.fontTitleLarge)
                .lineHeight(Dimens.lineTitleLarge)
            }
            .width(40)
            .height(40)
            .borderRadius(Dimens.radiusSmall)
            .clip(true)
            .onClick(() => {
              this.onEmojiSelected(emoji);
            })
          }
          .padding(Dimens.spacePaddingXSmall)
        }, (emoji: string, index: number) => index + '_' + emoji)
      }
      .columnsTemplate('1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr')
      .padding(Dimens.spacePaddingSmall)
      .layoutWeight(1)
      .width('100%')
      .edgeEffect(EdgeEffect.Spring)
    }
    .width('100%')
    .height('100%')
    .backgroundColor($r('app.color.surface'))
    .alignItems(HorizontalAlign.Start)
  }
}
