      "name": "guide_page_1_title",
      "value": "CoolMall - Open Source E-Commerce Learning Project"
    },
    {
      "name": "guide_page_1_desc",
      "value": "Modern e-commerce app developed in 100% Kotlin\nCompletely open source and free, helping developers grow fast\nProviding complete code references and learning resources"
    },
    {
      "name": "guide_page_2_title",
      "value": "Declarative UI Experience"
    },
    {
      "name": "guide_page_2_desc",
      "value": "Build smooth interfaces with Jetpack Compose\nMVVM + Clean Architecture\nFull integration of Hilt, Coroutines, Flow and more"
    },
    {
      "name": "guide_page_3_title",
      "value": "Complete E-Commerce Process"
    },
    {
      "name": "guide_page_3_desc",
      "value": "User authentication, product display, search & categories\nShopping cart management, full order & payment flow\nLearning cases close to real business scenarios"
    },
    {
      "name": "guide_page_4_title",
      "value": "Modular Architecture Design"
    },
    {
      "name": "guide_page_4_desc",
      "value": "Reference to Google Now in Android best practices\nHigh cohesion, low coupling, easy to maintain and extend\nQuality project for learning and secondary development"
    },
