  "steps": [
    {"op":"stop"},
    {"op":"start"},
    {"op":"wait","match":"搜索商品"},
    {"op":"tap","match":"=我的"},
    {"op":"wait","match":"=在线客服"},
    {"op":"tap","match":"=在线客服"},
