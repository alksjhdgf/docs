        {
          "at": "2026-10-14T20:29:56.819Z",
          "to": "waived",
          "reason": "The HarmonyOS SDK has no QQ OpenSDK (degradation deg-page-auth-login-128f0j open/no_equiv); tapping QQ only shows the launch-failed toast; the success/cancel branches cannot be triggered"
        }
      ],
      "reason": "The HarmonyOS SDK has no QQ OpenSDK (degradation deg-page-auth-login-128f0j open/no_equiv); tapping QQ only shows the launch-failed toast; the success/cancel branches cannot be triggered"
    },
