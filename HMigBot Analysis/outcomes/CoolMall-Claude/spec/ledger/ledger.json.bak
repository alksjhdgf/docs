      "deps": [
        "fnd-ui-base",
        "fnd-ui-widgets",
        "fnd-ui-commerce",
        "fnd-data",
        "fnd-util"
      ],
      "route": "CsRoutesChat",
      "featureIds": [
        "CS-A01",
        "CS-A02",
        "CS-A03",
        "CS-A04",
        "CS-A05",
        "CS-A06",
        "CS-A07",
        "CS-A08",
        "CS-A09",
        "CS-A10",
