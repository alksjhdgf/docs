      "id": "page-cs-chat",
      "title": "Customer service chat",
      "targetPath": [
        "output/CoolMallHM/entry/src/main/ets/pages/CsRoutesChatPage.ets",
        "output/CoolMallHM/entry/src/main/ets/feature/cs",
        "output/CoolMallHM/entry/src/main/resources/rawfile"
