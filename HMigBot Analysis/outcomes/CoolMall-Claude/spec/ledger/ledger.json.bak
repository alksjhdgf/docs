    {
      "id": "AUTH-A05",
      "kind": "on_device",
      "note": "Tapping `QQ` starts the QQ SDK authorization; on success it calls the QQ login API with accessToken+openId, and when the user cancels it shows the warning toast `登录取消`; when it fails it shows an error toast starting with `登录失败`; when launching throws it shows `启动QQ登录失败`",
      "anchor": "feature/auth/src/main/java/com/joker/coolmall/feature/auth/viewmodel/LoginViewModel.kt:38",
      "card": "Auth domain (AuthRoutesLogin / AccountLogin / SmsLogin / Register / ResetPassword)",
      "domain": "auth",
      "page": null,
      "status": "waived",
      "literals": [
