{
 "bundle": "com.nononsenseapps.feeder",
 "name": "flow-editdelete",
 "steps": [
  {
   "op": "start"
  },
  {
   "op": "sleep",
   "ms": 3000
  },
  {
   "op": "tap",
   "match": "type:^Button$",
   "nth": 0
  },
  {
   "op": "tap",
   "match": "^Feeder News"
  },
  {
   "op": "wait",
   "match": "=Sep 20, 2026"
  },
  {
   "op": "tap",
   "match": "type:^Button$",
   "nth": 3
  },
  {
   "op": "wait",
   "match": "=Edit feed",
   "timeout": 4000
  },
  {
   "op": "tap",
   "match": "=Edit feed"
  },
  {
   "op": "wait",
   "match": "=editFeedTitle"
  },
  {
   "op": "type",
   "match": "=editFeedTitle",
   "text": "Feeder Renamed"
  },
  {
   "op": "scrollUntil",
   "match": "=OK",
   "dir": "up",
   "max": 8
  },
  {
   "op": "tap",
   "match": "=OK"
  },
  {
   "op": "tap",
   "match": "type:^Button$",
   "nth": 0
  },
  {
   "op": "expect",
   "match": [
    "^Feeder Renamed"
   ]
  },
  {
   "op": "alive"
  }
 ]
}