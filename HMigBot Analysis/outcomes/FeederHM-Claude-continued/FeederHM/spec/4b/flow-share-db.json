{
 "bundle": "com.nononsenseapps.feeder",
 "name": "flow-share-db",
 "steps": [
  {
   "op": "start"
  },
  {
   "op": "wait",
   "match": "type:^Button$",
   "timeout": 15000
  },
  {
   "op": "tap",
   "match": "type:^Button$",
   "nth": 0
  },
  {
   "op": "wait",
   "match": "=All feeds",
   "timeout": 4000
  },
  {
   "op": "tap",
   "match": "=All feeds"
  },
  {
   "op": "sleep",
   "ms": 1500
  },
  {
   "op": "longpress",
   "match": "^2.24.0 released",
   "nth": 0
  },
  {
   "op": "wait",
   "match": "=Share",
   "timeout": 4000
  },
  {
   "op": "tap",
   "match": "=Share"
  },
  {
   "op": "wait",
   "match": "=Share",
   "timeout": 5000
  },
  {
   "op": "expect",
   "match": [
    "=Share",
    "=2.24.0 released"
   ]
  },
  {
   "op": "shot",
   "name": "flow-share-item-sheet"
  },
  {
   "op": "back"
  },
  {
   "op": "sleep",
   "ms": 800
  },
  {
   "op": "longpress",
   "match": "^2.24.0 released",
   "nth": 0
  },
  {
   "op": "wait",
   "match": "^(Save article|Stop saving article)$",
   "timeout": 4000
  },
  {
   "op": "tap",
   "match": "=Save article"
  },
  {
   "op": "sleep",
   "ms": 800
  },
  {
   "op": "start"
  },
  {
   "op": "wait",
   "match": "type:^Button$",
   "timeout": 15000
  },
  {
   "op": "tap",
   "match": "type:^Button$",
   "nth": 0
  },
  {
   "op": "wait",
   "match": "=Saved articles",
   "timeout": 4000
  },
  {
   "op": "tap",
   "match": "=Saved articles"
  },
  {
   "op": "sleep",
   "ms": 1500
  },
  {
   "op": "expect",
   "match": [
    "^2.24.0 released"
   ]
  },
  {
   "op": "shot",
   "name": "flow-saved-after-coldstart"
  },
  {
   "op": "tap",
   "match": "^2.24.0 released",
   "nth": 0
  },
  {
   "op": "wait",
   "match": "=0:59 minutes",
   "timeout": 6000
  },
  {
   "op": "tap",
   "match": "type:^Button$",
   "nth": 3
  },
  {
   "op": "wait",
   "match": "=Read aloud",
   "timeout": 4000
  },
  {
   "op": "tap",
   "match": "=Share"
  },
  {
   "op": "wait",
   "match": "=Share",
   "timeout": 5000
  },
  {
   "op": "shot",
   "name": "flow-share-article-sheet"
  },
  {
   "op": "back"
  },
  {
   "op": "sleep",
   "ms": 800
  },
  {
   "op": "tap",
   "match": "type:^Button$",
   "nth": 2
  },
  {
   "op": "wait",
   "match": "news.nononsenseapps.com",
   "timeout": 10000
  },
  {
   "op": "shot",
   "name": "flow-article-webview"
  },
  {
   "op": "back"
  },
  {
   "op": "alive"
  }
 ]
}