{
 "bundle": "com.nononsenseapps.feeder",
 "name": "flow-notify-browser",
 "steps": [
  {
   "op": "key",
   "name": "Home"
  },
  {
   "op": "start"
  },
  {
   "op": "wait",
   "match": "type:^Button$",
   "timeout": 15000
  },
  {
   "op": "tap",
   "match": "type:^Button$",
   "nth": 3
  },
  {
   "op": "wait",
   "match": "=Settings",
   "timeout": 4000
  },
  {
   "op": "tap",
   "match": "=Settings"
  },
  {
   "op": "wait",
   "match": "=Theme"
  },
  {
   "op": "scrollUntil",
   "match": "=Open items by default with",
   "dir": "up",
   "max": 10
  },
  {
   "op": "swipe",
   "dir": "up"
  },
  {
   "op": "tap",
   "match": "=Open items by default with"
  },
  {
   "op": "wait",
   "match": "=Default browser",
   "timeout": 4000
  },
  {
   "op": "tap",
   "match": "=Default browser"
  },
  {
   "op": "sleep",
   "ms": 800
  },
  {
   "op": "expect",
   "match": [
    "=Default browser"
   ]
  },
  {
   "op": "back"
  },
  {
   "op": "wait",
   "match": "type:^Button$",
   "timeout": 15000
  },
  {
   "op": "tap",
   "match": "type:^Button$",
   "nth": 0
  },
  {
   "op": "wait",
   "match": "=Hacker News: Newest",
   "timeout": 4000
  },
  {
   "op": "tap",
   "match": "=Hacker News: Newest"
  },
  {
   "op": "sleep",
   "ms": 1500
  },
  {
   "op": "tap",
   "match": "type:^Button$",
   "nth": 3
  },
  {
   "op": "wait",
   "match": "=Delete feed",
   "timeout": 4000
  },
  {
   "op": "tap",
   "match": "=Delete feed"
  },
  {
   "op": "wait",
   "match": "=Cancel",
   "timeout": 4000
  },
  {
   "op": "tap",
   "match": "=Hacker News: Newest"
  },
  {
   "op": "tap",
   "match": "=OK"
  },
  {
   "op": "sleep",
   "ms": 2000
  },
  {
   "op": "tap",
   "match": "type:^Button$",
   "nth": 3
  },
  {
   "op": "wait",
   "match": "=Add feed",
   "timeout": 4000
  },
  {
   "op": "tap",
   "match": "=Add feed"
  },
  {
   "op": "wait",
   "match": "=urlField",
   "timeout": 6000
  },
  {
   "op": "type",
   "match": "=urlField",
   "text": "https://hnrss.org/newest"
  },
  {
   "op": "tap",
   "match": "=Search"
  },
  {
   "op": "wait",
   "match": "=searchResult",
   "timeout": 20000
  },
  {
   "op": "tap",
   "match": "=searchResult"
  },
  {
   "op": "wait",
   "match": "=editFeedTitle",
   "timeout": 6000
  },
  {
   "op": "scrollUntil",
   "match": "=editFeedNotify",
   "dir": "up",
   "max": 4
  },
  {
   "op": "swipe",
   "dir": "up"
  },
  {
   "op": "tap",
   "match": "=editFeedNotify"
  },
  {
   "op": "shot",
   "name": "flow-notify-browser-editfeed-on"
  },
  {
   "op": "scrollUntil",
   "match": "=OK",
   "dir": "up",
   "max": 10
  },
  {
   "op": "tap",
   "match": "=OK"
  },
  {
   "op": "sleep",
   "ms": 15000
  },
  {
   "op": "swipeRaw",
   "from": [
    300,
    2
   ],
   "to": [
    300,
    1500
   ],
   "speed": 800,
   "ms": 2000
  },
  {
   "op": "shot",
   "name": "flow-notify-browser-shade"
  },
  {
   "op": "tapAt",
   "x": 1180,
   "y": 1000,
   "ms": 1500
  },
  {
   "op": "shot",
   "name": "flow-notify-browser-expanded"
  },
  {
   "op": "tapAt",
   "x": 400,
   "y": 1336,
   "ms": 1500
  },
  {
   "op": "shot",
   "name": "flow-notify-browser-item-actions"
  },
  {
   "op": "tapAt",
   "x": 400,
   "y": 1336,
   "ms": 6000
  },
  {
   "op": "shot",
   "name": "flow-notify-browser-opened"
  },
  {
   "op": "start"
  },
  {
   "op": "wait",
   "match": "type:^Button$",
   "timeout": 15000
  },
  {
   "op": "shot",
   "name": "flow-notify-browser-list-after"
  },
  {
   "op": "tap",
   "match": "type:^Button$",
   "nth": 3
  },
  {
   "op": "wait",
   "match": "=Settings",
   "timeout": 4000
  },
  {
   "op": "tap",
   "match": "=Settings"
  },
  {
   "op": "wait",
   "match": "=Theme"
  },
  {
   "op": "scrollUntil",
   "match": "=Open items by default with",
   "dir": "up",
   "max": 10
  },
  {
   "op": "swipe",
   "dir": "up"
  },
  {
   "op": "tap",
   "match": "=Open items by default with"
  },
  {
   "op": "wait",
   "match": "=Reader",
   "timeout": 4000
  },
  {
   "op": "tap",
   "match": "=Reader"
  },
  {
   "op": "sleep",
   "ms": 800
  },
  {
   "op": "alive"
  }
 ]
}