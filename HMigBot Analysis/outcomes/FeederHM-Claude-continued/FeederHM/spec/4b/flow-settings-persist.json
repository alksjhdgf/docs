{"bundle":"com.nononsenseapps.feeder","name":"flow-settings-persist","steps":[
 {"op":"start"},
 {"op":"wait","match":"type:^Button$","timeout":15000},
 {"op":"tap","match":"type:^Button$","nth":3},
 {"op":"wait","match":"=Settings","timeout":4000},
 {"op":"tap","match":"=Settings"},
 {"op":"wait","match":"=Theme"},
 {"op":"tap","match":"=Theme"},
 {"op":"wait","match":"=Day","timeout":4000},
 {"op":"tap","match":"=Day"},
 {"op":"sleep","ms":800},
 {"op":"tap","match":"=Preferred dark theme"},
 {"op":"wait","match":"=Dark","timeout":4000},
 {"op":"tap","match":"=Dark"},
 {"op":"sleep","ms":800},
 {"op":"shot","name":"settings-set"},
 {"op":"start"},
 {"op":"wait","match":"type:^Button$","timeout":15000},
 {"op":"tap","match":"type:^Button$","nth":3},
 {"op":"wait","match":"=Settings","timeout":4000},
 {"op":"tap","match":"=Settings"},
 {"op":"wait","match":"=Theme"},
 {"op":"expect","match":["=Day","=Dark"]},
 {"op":"shot","name":"settings-after-restart"},
 {"op":"alive"}
]}
