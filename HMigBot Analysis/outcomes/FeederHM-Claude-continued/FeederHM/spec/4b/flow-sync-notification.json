{
 "bundle": "com.nononsenseapps.feeder",
 "name": "flow-sync-notification",
 "steps": [
  {
   "op": "key",
   "name": "Home"
  },
  {
   "op": "start"
  },
  {
   "op": "wait",
   "match": "type:^Button$",
   "timeout": 15000
  },
  {
   "op": "tap",
   "match": "type:^Button$",
   "nth": 0
  },
  {
   "op": "wait",
   "match": "=All feeds",
   "timeout": 4000
  },
  {
   "op": "tap",
   "match": "=All feeds"
  },
  {
   "op": "sleep",
   "ms": 1000
  },
  {
   "op": "tap",
   "match": "type:^Button$",
   "nth": 3
  },
  {
   "op": "wait",
   "match": "=Sync feeds",
   "timeout": 4000
  },
  {
   "op": "tap",
   "match": "=Sync feeds",
   "ms": 300
  },
  {
   "op": "swipeRaw",
   "from": [
    300,
    2
   ],
   "to": [
    300,
    1500
   ],
   "speed": 1500,
   "ms": 800
  },
  {
   "op": "shot",
   "name": "flow-sync-notification-during"
  },
  {
   "op": "sleep",
   "ms": 30000
  },
  {
   "op": "shot",
   "name": "flow-sync-notification-after"
  },
  {
   "op": "key",
   "name": "Back"
  },
  {
   "op": "sleep",
   "ms": 60000
  },
  {
   "op": "swipeRaw",
   "from": [
    300,
    2
   ],
   "to": [
    300,
    1500
   ],
   "speed": 1500,
   "ms": 1500
  },
  {
   "op": "shot",
   "name": "flow-sync-notification-removed"
  },
  {
   "op": "key",
   "name": "Back"
  }
 ]
}