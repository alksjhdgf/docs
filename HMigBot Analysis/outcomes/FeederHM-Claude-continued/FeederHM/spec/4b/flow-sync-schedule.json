{"bundle":"com.nononsenseapps.feeder","name":"flow-sync-schedule","steps":[
 {"op":"key","name":"Home"},
 {"op":"start"},
 {"op":"wait","match":"type:^Button$","timeout":15000},
 {"op":"tap","match":"type:^Button$","nth":3},
 {"op":"wait","match":"=Settings","timeout":4000},
 {"op":"tap","match":"=Settings"},
 {"op":"wait","match":"=Theme"},
 {"op":"scrollUntil","match":"=Look for new articles…","dir":"up","max":6},
 {"op":"tap","match":"=Look for new articles…"},
 {"op":"wait","match":"=Every 3 hours","timeout":4000},
 {"op":"tap","match":"=Every 3 hours"},
 {"op":"sleep","ms":1500},
 {"op":"expect","match":["=Every 3 hours"]},
 {"op":"tap","match":"=Only on Wi-Fi"},
 {"op":"sleep","ms":1500},
 {"op":"tap","match":"=Only when charging"},
 {"op":"sleep","ms":1500},
 {"op":"shot","name":"flow-sync-schedule-3h-wifi-charging"},
 {"op":"tap","match":"=Look for new articles…"},
 {"op":"wait","match":"=Manually","timeout":4000},
 {"op":"tap","match":"=Manually"},
 {"op":"sleep","ms":1500},
 {"op":"expect","match":["=Manually"]},
 {"op":"tap","match":"=Look for new articles…"},
 {"op":"wait","match":"=Every hour","timeout":4000},
 {"op":"tap","match":"=Every hour"},
 {"op":"sleep","ms":1500},
 {"op":"tap","match":"=Only on Wi-Fi"},
 {"op":"sleep","ms":1500},
 {"op":"tap","match":"=Only when charging"},
 {"op":"sleep","ms":1500},
 {"op":"expect","match":["=Every hour"]},
 {"op":"shot","name":"flow-sync-schedule-restored"},
 {"op":"alive"}
]}
