{
 "bundle": "com.nononsenseapps.feeder",
 "name": "flow-nav",
 "steps": [
  {
   "op": "start"
  },
  {
   "op": "wait",
   "match": "=Sep 20, 2026",
   "timeout": 20000
  },
  {
   "op": "tap",
   "match": "type:^Button$",
   "nth": 0
  },
  {
   "op": "tap",
   "match": "^Feeder News"
  },
  {
   "op": "wait",
   "match": "=Sep 20, 2026"
  },
  {
   "op": "expect",
   "match": [
    "^Feeder News"
   ]
  },
  {
   "op": "tap",
   "match": "=Sep 20, 2026"
  },
  {
   "op": "wait",
   "match": "=readerColumn"
  },
  {
   "op": "expect",
   "match": [
    "=2.23.2 released"
   ]
  },
  {
   "op": "back"
  },
  {
   "op": "wait",
   "match": "=Sep 20, 2026"
  },
  {
   "op": "tap",
   "match": "type:^Button$",
   "nth": 0
  },
  {
   "op": "expect",
   "match": [
    "=Saved articles"
   ]
  },
  {
   "op": "tap",
   "match": "^All feeds"
  },
  {
   "op": "wait",
   "match": "^All feeds"
  },
  {
   "op": "tap",
   "match": "type:^Button$",
   "nth": 3
  },
  {
   "op": "wait",
   "match": "=Settings",
   "timeout": 4000
  },
  {
   "op": "tap",
   "match": "=Settings"
  },
  {
   "op": "wait",
   "match": "=Theme"
  },
  {
   "op": "back"
  },
  {
   "op": "tap",
   "match": "type:^Button$",
   "nth": 0
  },
  {
   "op": "expect",
   "match": [
    "=Saved articles"
   ]
  },
  {
   "op": "alive"
  }
 ]
}