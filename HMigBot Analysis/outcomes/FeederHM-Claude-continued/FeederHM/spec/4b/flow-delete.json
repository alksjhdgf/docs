{"bundle":"com.nononsenseapps.feeder","name":"flow-delete","steps":[
 {"op":"start"},
 {"op":"wait","match":"type:^Button$","timeout":15000},
 {"op":"tap","match":"type:^Button$","nth":0},
 {"op":"expect","match":["Hacker News"]},
 {"op":"back"},
 {"op":"tap","match":"type:^Button$","nth":3},
 {"op":"wait","match":"=Delete feed","timeout":4000},
 {"op":"tap","match":"=Delete feed"},
 {"op":"wait","match":"=Cancel","timeout":4000},{"op":"shot","name":"flow-delete-dialog"},
 {"op":"tap","match":"=Hacker News: Front Page"},
 {"op":"tap","match":"=OK"},
 {"op":"sleep","ms":1200},
 {"op":"tap","match":"type:^Button$","nth":0},
 {"op":"probe","match":["Hacker News","Feeder Renamed"]},
 {"op":"shot","name":"flow-delete-after"},
 {"op":"alive"}
]}
