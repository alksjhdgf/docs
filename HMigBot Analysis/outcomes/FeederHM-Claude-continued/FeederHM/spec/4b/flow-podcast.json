{
 "bundle": "com.nononsenseapps.feeder",
 "name": "flow-podcast",
 "steps": [
  {
   "op": "key",
   "name": "Home"
  },
  {
   "op": "start"
  },
  {
   "op": "wait",
   "match": "type:^Button$",
   "timeout": 15000
  },
  {
   "op": "tap",
   "match": "type:^Button$",
   "nth": 3
  },
  {
   "op": "wait",
   "match": "=Add feed",
   "timeout": 4000
  },
  {
   "op": "tap",
   "match": "=Add feed"
  },
  {
   "op": "wait",
   "match": "=urlField",
   "timeout": 6000
  },
  {
   "op": "type",
   "match": "=urlField",
   "text": "https://changelog.com/podcast/feed"
  },
  {
   "op": "tap",
   "match": "=Search"
  },
  {
   "op": "wait",
   "match": "=searchResult",
   "timeout": 30000
  },
  {
   "op": "tap",
   "match": "=searchResult",
   "nth": 0
  },
  {
   "op": "wait",
   "match": "=editFeedTitle",
   "timeout": 6000
  },
  {
   "op": "scrollUntil",
   "match": "=OK",
   "dir": "up",
   "max": 10
  },
  {
   "op": "tap",
   "match": "=OK"
  },
  {
   "op": "sleep",
   "ms": 10000
  },
  {
   "op": "tap",
   "match": "type:^Button$",
   "nth": 0
  },
  {
   "op": "wait",
   "match": "^The Changelog",
   "timeout": 6000
  },
  {
   "op": "tap",
   "match": "^The Changelog",
   "nth": 0
  },
  {
   "op": "sleep",
   "ms": 2000
  },
  {
   "op": "tap",
   "match": "type:^Stack$",
   "nth": 0
  },
  {
   "op": "wait",
   "match": "^Open .*\\.mp3$",
   "timeout": 8000
  },
  {
   "op": "tap",
   "match": "^Open .*\\.mp3$"
  },
  {
   "op": "sleep",
   "ms": 15000
  },
  {
   "op": "shot",
   "name": "flow-podcast-playing"
  },
  {
   "op": "alive"
  }
 ]
}